# ── Xpense AI — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# Names here match app/core/config.py exactly; anything else is ignored.

# Core
APP_NAME=xpense-ai
DEBUG=true
# JSON list. Use your deployed frontend origin in production instead of "*".
ALLOWED_ORIGINS=["*"]

# Database
# Leave unset to use the bundled SQLite file (sqlite+aiosqlite:///./xpense_ai.db).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/xpense_ai

# JWT
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bcrypt
BCRYPT_ROUNDS=12

# Google Cloud (Vision API — OCR fallback when Groq Vision is unavailable)
GOOGLE_APPLICATION_CREDENTIALS=

# LLM provider — Groq is tried first, Anthropic second.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_OCR_MODEL=qwen/qwen3.8-27b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# RAG / retrieval
# auto   — pick from the container's memory limit (default)
# chroma — vector search with a local ONNX embedding model; needs ~1.5 GB
# lite   — in-memory BM25; no extra dependencies, fits a 512 MB instance
RAG_BACKEND=auto
CHROMA_DIR=./chroma_db
RAG_COLLECTION=finance_knowledge
RAG_TOP_K=3
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
